{
  "name": "huong-hoa-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "verify:calendar": "node scripts/verify-calendar.mjs",
    "verify:family": "node scripts/verify-family.mjs",
    "verify:preparation": "node scripts/verify-preparation.mjs",
    "verify": "npm run verify:calendar && npm run verify:family && npm run verify:preparation",
    "check": "npm run typecheck && npm run lint && npm run verify && npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.24",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
